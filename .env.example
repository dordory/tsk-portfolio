# TSK 환경변수 템플릿.
# 이 파일을 복사해서 .env 로 만들고 값을 채운다:  cp .env.example .env
# .env 는 git 에 커밋되지 않는다(.gitignore 등록됨).

# ── Django 기본 ──────────────────────────────────────────────
# 개발: True, 운영: False
DEBUG=True
# 운영에서는 반드시 고유한 값으로 교체 (미설정 시 개발용 기본값 사용)
SECRET_KEY=
# 콤마로 구분. 예: example.com,www.example.com  (미설정 시 * )
ALLOWED_HOSTS=
# 콤마로 구분. 예: https://example.com
CSRF_TRUSTED_ORIGINS=

# 화면에 표시할 회중(조직) 이름. 미설정 시 '회중'.
CONGREGATION_NAME=

# 긴급연락처 임포트에서 제외할 이름(콤마 구분). 개인정보라 코드에 두지 않는다.
EMERGENCY_IMPORT_EXCLUDE_NAMES=

# ── LINE MINI App / LIFF ─────────────────────────────────────
# LINE Developers 콘솔의 MINI App 채널에서 발급.
# 둘 다 채워지면 LINE 로그인이 활성화되고, WebView 쿠키도 자동으로 켜진다.
LINE_LIFF_ID=
LINE_CHANNEL_ID=

# ── LINE Messaging API (공식어카운트 봇 — 그룹 키워드 → Flex 메뉴) ──
# LIFF 채널과 별개인 Messaging API 채널에서 발급. 둘 다 채워지면 웹훅 활성화.
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_ACCESS_TOKEN=
# Flex 이미지 절대 URL 조립용 사이트 도메인 (끝 슬래시 없이)
SITE_BASE_URL=

# WebView 쿠키(SameSite=None; Secure) 강제 on/off. 보통 비워두면 자동 판정.
# 1=강제 on, 0=강제 off
WEBVIEW_COOKIES=

# ── 아웃바운드 프록시 (PythonAnywhere 무료 계정 등) ──────────
# 외부 접속이 프록시를 거쳐야 하는 환경에서만 설정. 그 외에는 비워둔다.
# HTTPS_PROXY=http://proxy.server:3128
# HTTP_PROXY=http://proxy.server:3128

# ── territory_cards (구역카드 = 구글시트) ────────────────────
# 구역 데이터의 소스는 DB 가 아니라 구글시트. 서비스 계정으로 Sheets API 접근.
# 대상 시트들을 서비스 계정 이메일에 "공유"해두어야 한다.
# 아래 둘 중 하나로 서비스계정 키를 주입(파일 경로 우선순위는 코드 참고):
#   1) 키 JSON 파일 경로
GOOGLE_SERVICE_ACCOUNT_FILE=
#   2) 키 JSON 문자열 그 자체(한 줄로). FILE 이 비어있을 때 사용.
GOOGLE_SERVICE_ACCOUNT_JSON=
# 마스터 인덱스("시트리스트_시트")의 spreadsheetId (URL 의 /d/<이 부분>/edit)
TERRITORY_CARDS_MASTER_SHEET_ID=

# ── board (회중게시판 = 구글드라이브 폴더) ────────────────────
# 위와 같은 서비스 계정으로 Drive API 접근(폴더를 서비스계정에 '뷰어' 공유 필요).
# 회중게시판 폴더의 folderId (URL 의 /folders/<이 부분>)
CONGREGATION_BOARD_FOLDER_ID=
